        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<style>\n  body { background: #0a0908; margin: 0; padding: 30px 0; font-family: Georgia, serif; }\n  .wrap { max-width: 520px; margin: 0 auto; background: #131110; border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; overflow: hidden; }\n  .header { background: #0a0908; padding: 28px 32px 20px; border-bottom: 1px solid rgba(255,255,255,0.06); }\n  .logo { font-size: 13px; font-style: italic; color: #c9954a; letter-spacing: 1px; margin-bottom: 4px; }\n  .logo span { color: #ede6db; font-style: normal; }\n  .header-sub { font-size: 11px; color: #6b5f52; font-family: 'Courier New', monospace; text-transform: uppercase; letter-spacing: 2px; }\n  .body { padding: 28px 32px; }\n  .row { margin-bottom: 20px; }\n  .label { font-size: 9px; font-family: 'Courier New', monospace; text-transform: uppercase; letter-spacing: 2px; color: #c9954a; margin-bottom: 5px; }\n  .value { font-size: 14px; color: #ede6db; line-height: 1.6; font-family: Georgia, serif; }\n  .value.muted { color: #a89880; font-size: 13px; }\n  .divider { height: 1px; background: rgba(255,255,255,0.05); margin: 20px 0; }\n  .tag { display: inline-block; background: rgba(201,149,74,0.12); border: 1px solid rgba(201,149,74,0.28); border-radius: 20px; padding: 3px 10px; font-size: 10px; font-family: 'Courier New', monospace; text-transform: uppercase; letter-spacing: 1px; color: #c9954a; }\n  .tag.bug { background: rgba(201,86,104,0.12); border-color: rgba(201,86,104,0.28); color: #c95668; }\n  .footer { background: #0a0908; padding: 16px 32px; border-top: 1px solid rgba(255,255,255,0.05); font-size: 9px; font-family: 'Courier New', monospace; text-transform: uppercase; letter-spacing: 1.5px; color: #6b5f52; }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"header\">\n    <div class=\"logo\">Signl <span>Cycle</span></div>\n    <div class=\"header-sub\">New feedback received</div>\n  </div>\n  <div class=\"body\">\n    <div class=\"ro